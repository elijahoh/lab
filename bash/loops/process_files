#!/bin/bash

# Generate files to test the script
for i in {1..5}; do touch "file_test${i}.txt"; done

# Looping over the files
for file in *.txt; do
	# Handle case when no files match
	[[ -f "${file}" ]] || continue
	echo "Processing: ${file}"
done
echo ""
echo ""

# Remove the files generated by this script
for n in {1..5}; do
	echo "Removing: file_test${n}.txt"
	rm "file_test${n}.txt"
done
