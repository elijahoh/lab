#!/bin/bash

# Generate files to test the script
for i in {1..5}; do touch "file_test${i}.txt"; done

# Looping over the files
for file in file_test*; do
	# Handle case when no files match
	[[ -f "${file}" ]] || continue
	newname="backup_${file}"
	mv "${file}" "${newname}"
	echo "Rename ${file} to ${newname}"
done
echo ""
echo ""
echo "Batched rename files:"
for file in backup*; do
	echo "${file}"
done
echo ""
echo ""
# Remove the files generated by this script
for n in {1..5}; do
	echo "Removing: backup_file_test${n}.txt"
	rm "backup_file_test${n}.txt"
done
